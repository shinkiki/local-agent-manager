# Tailscale 사이드카
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=agent-manager

# 서버가 신원 헤더와 대조할 값.
# TAILSCALE_HOST 는 사이드카 노드의 MagicDNS 이름 (예: agent-manager.tailnet-xxxx.ts.net)
# TAILSCALE_USER 는 접속을 허용할 tailnet 로그인 (예: you@example.com)
TAILSCALE_HOST=agent-manager.tailnet-xxxx.ts.net
TAILSCALE_USER=you@example.com

# 시크릿 서비스 잠금 해제 암호. 임의의 긴 문자열로 지정한다.
KEYRING_PASSWORD=

# 원격에서 변경 작업 허용 여부.
# 기동할 때마다 이 값을 앱 데이터의 백엔드 서비스 설정(remoteWrite)에 기록한다.
# 설정 화면(설정 → 백엔드 서비스 → 원격 편집 허용)에서 바꾼 값을 유지하려면 이 값도 맞춘다.
AGENT_MANAGER_REMOTE_WRITE=false

# 에이전트가 다룰 프로젝트 디렉터리 (NAS 공유 폴더 경로)
WORKSPACE_DIR=./workspace
