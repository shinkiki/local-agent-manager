# Tailscale 사이드카
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=agent-manager
# 사이드카의 데이터패스 모드. 기본은 사용자 공간 모드(true)다 — 커널 4.4 NAS에서
# 커널 모드는 connmark 규칙을 넣지 못해 Health 경고가 계속 올라온다(L10 실측 2026-10-11).
# 커널 모드로 쓰려면 이 줄을 `false`로 둔다.
# 허용 값은 `true`/`false`뿐이고, 그 밖의 값은 앱 컨테이너가 기동을 거부한다
# (근거: deploy/synology/entrypoint.sh의 L10 블록).
TS_USERSPACE=true

# 서버가 신원 헤더와 대조할 값.
# TAILSCALE_HOST 는 사이드카 노드의 MagicDNS 이름 (예: agent-manager.tailnet-xxxx.ts.net)
# TAILSCALE_USER 는 접속을 허용할 tailnet 로그인 (예: you@example.com)
TAILSCALE_HOST=agent-manager.tailnet-xxxx.ts.net
TAILSCALE_USER=you@example.com

# 시크릿 서비스 잠금 해제 암호. 임의의 긴 문자열로 지정한다.
KEYRING_PASSWORD=

# 원격에서 변경 작업 허용 여부.
# (C20) 원격 권한은 환경변수가 아니라 설정 → 시스템 → 로그인 설정이 정한다. 첫 접속 뒤
# 비밀번호·OTP를 등록하고 원격 채널에 켜 두면 Tailscale 뒤의 접속자도 로그인해야 한다.

# 에이전트가 다룰 프로젝트 디렉터리 (NAS 공유 폴더 경로)
WORKSPACE_DIR=./workspace

# 에이전트 CLI를 이미지 씨앗 버전으로 되돌릴 때만 1로 적는다. 한 번 기동해 되돌린 뒤 지운다
# (남겨 두면 기동할 때마다 앱에서 올린 버전을 덮는다). README의 "에이전트 CLI 업데이트" 절.
# AGENT_MANAGER_RESEED_CLI=1
