{
  "id": "aia-agent-manager-headless-gap-round",
  "displayName": "Agent Manager 헤드리스 제한 개선",
  "description": "회차 봉투가 정한 계정·모델로 agent-manager-tauri 저장소에 무인 런타임 한 건을 띄워 headless-linux-gap-round 스킬을 따라 docs/headless-linux-gaps.md의 '대기' 항목 1건을 개선 또는 실측 검증하고, 독립 코드리뷰 관문을 거쳐 커밋·private/dev-history 착지·record_round_report 보고까지 끝낸다. Claude·Codex·Antigravity 레인 모델을 지원한다. 각 회차는 .rounds 아래 레인(G01~G05) 워크트리와 항목 점유(gap-<ID>)를 잡고 push 락으로 착지를 직렬화하므로 병렬 5건까지 안전하다. 주 워크트리는 건드리지 않는다. 개별 회차는 운영 NAS를 조회만 하고, 전체 구현·리뷰·착지 회차 종료 후 스킬 8-1절에 따라 검증된 이미지로 컨테이너를 재생성·기동한 뒤 남은 NAS 검증을 마무리한다. 기동 건수·계정·주기는 워크플로 페이싱 탭의 회차가 정한다.",
  "inputSchema": {
    "antigravityModel": { "type": "string", "values": null, "required": true, "label": "Antigravity 레인 모델", "description": "Antigravity 계정으로 띄울 런타임의 모델", "defaultValue": "gemini-3.1-pro-high" },
    "claudeModel": { "type": "string", "values": null, "required": true, "label": "claude 레인 모델", "description": "claude 계정으로 띄울 런타임의 모델", "defaultValue": "claude-opus-5" },
    "codexModel": { "type": "string", "values": null, "required": true, "label": "codex 레인 모델", "description": "codex 계정으로 띄울 런타임의 모델", "defaultValue": "gpt-6.1-sol" },
    "message": { "type": "string", "values": null, "required": true, "label": "무인 런타임 지시문", "description": "무인 런타임에 보낼 첫 메시지", "defaultValue": "headless-linux-gap-round 스킬을 따라 docs/headless-linux-gaps.md의 대기 항목 1건을 처리하고 코드리뷰·커밋·착지·record_round_report 보고까지 끝내줘." },
    "projectPath": { "type": "string", "values": null, "required": true, "label": "대상 저장소", "description": "무인 런타임을 띄울 절대경로", "defaultValue": "/path/to/agent-manager-tauri" }
  },
  "steps": [
    {
      "id": "s01",
      "operation": "start_chat",
      "arguments": {
        "request": {
          "chat": {
            "accountId": { "$run": "accountId" },
            "approvalMode": "never",
            "cwd": { "$run": "cwd" },
            "handoffOrigin": null,
            "mode": "fullAccess",
            "model": { "$run": "model" },
            "pinAccount": true,
            "profile": "standard",
            "reasoningEffort": { "$run": "reasoningEffort" },
            "resumeSessionId": null,
            "settings": {},
            "source": { "$run": "source" },
            "unattended": true
          },
          "idempotencyKey": { "$idempotencyKey": true },
          "message": { "$input": "message" }
        }
      },
      "forEach": null,
      "condition": null,
      "expect": null
    }
  ],
  "risk": "mutating",
  "version": 4,
  "paced": true
}
